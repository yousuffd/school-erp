# Server
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# Database (Postgres - shared cluster, RLS for small tenants, schema-per-tenant for mid/large per blueprint 4.3)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=school_erp
DB_PASSWORD=school_erp
DB_DATABASE=school_erp
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Auth
JWT_ACCESS_SECRET=7bfd285abf673bf1d7a578a7b3fe3c7cceefc7c472766ccb61560df6f3fee7b9
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=4acb42fd7f3a55b5d081acba00ee41fffa039bd679d47b12998f138536109efb
JWT_REFRESH_TTL=7d

# SSO (placeholders - wired via Auth0/Ory later, blueprint Part 3)
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=

# CORS - comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Required for POST /tenants bootstrap path (see TenantProvisioningGuard) —
# generate with: openssl rand -hex 32
PROVISIONING_API_KEY=
